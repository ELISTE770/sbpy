# מפתח ה-API של Gemini. בלעדיו SBpy עדיין עובד - רק בלי שכבת ההסלמה.
GEMINI_API_KEY=your-key-here

# --- שלוש דרגות המודל ---
# auto    = הסלמה אוטומטית (שגיאה בריצה). חייב להיות הזול.
# command = פקודה מפורשת: @... ב-shell או sbpy exp app.py
# pro     = רק עם `+` בסוף השורה או --pro
SBPY_MODEL_AUTO=gemini-3.5-flash-lite
SBPY_MODEL_COMMAND=gemini-3.6-flash
SBPY_MODEL_PRO=gemini-3.1-pro-preview
SBPY_TIMEOUT=60

# --- שליטה בעלות ---
SBPY_OFFLINE=0            # 1 = לעולם לא לפנות ל-Gemini
SBPY_THRESHOLD=0.72       # ביטחון מקומי שמעליו לא מסלימים
SBPY_MAX_CALLS_RUN=10     # תקרת פניות בריצה אחת
SBPY_MAX_CALLS_DAY=200    # תקרת פניות ליום
SBPY_CACHE=1
SBPY_CACHE_TTL=30

# --- שכבות מקומיות (כיבוי = יותר פניות ל-Gemini) ---
SBPY_INDEX=1              # אינדקס סמלים לכל הפרויקט
SBPY_KB=1                 # בסיס ידע מקומי לשגיאות נפוצות
SBPY_LEARN=1              # זיקוק כללים מתשובות Gemini

# --- פרטיות ---
SBPY_REDACT=1             # ניקוי סודות לפני שליחה
SBPY_STORE=0              # אל תשמור את הפנייה בשרת
SBPY_CONTEXT_LINES=8

# --- תצוגה ---
SBPY_LANG=he              # he | en
SBPY_COLOR=1

# --- רשת ---
SBPY_SSL=auto             # auto | system | certifi
